# Set to false to use the real ML classifier (requires model weights)
# Set to true to run with a mock classifier (no GPU or model weights needed)
USE_MOCK=true

# Path to a locally trained model directory (optional)
# Leave blank to use the default HuggingFace model (gianlab/swin-tiny-patch4-window7-224-finetuned-skin-cancer)
# SKIN_MODEL_PATH=/path/to/your/backend/models/skin_classifier
